# Gatekeeper Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# Base URL for the Gatekeeper API (include /api prefix if applicable)
VITE_API_BASE_URL=http://localhost:5001/api

# Request timeout in milliseconds
VITE_API_TIMEOUT=30000

# Use mock scanner service (set to false to use real API)
VITE_USE_MOCK=true