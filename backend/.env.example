# Gatekeeper Backend Environment Variables
# Copy this file to .env and fill in your values

# Flask Secret Key
SECRET_KEY=dev-secret-change-in-production

# JWT Secret Key
JWT_SECRET_KEY=jwt-secret-change-in-production

# Database
DATABASE_URL=postgresql://postgres:gatekeeper@localhost:5432/gatekeeper

# CORS
CORS_ORIGINS=http://localhost:3000

# Microsoft Entra ID (Azure AD) SSO
MICROSOFT_CLIENT_ID=e72b3e1b-baa8-4164-99b1-f1b5e7c01eeb
MICROSOFT_CLIENT_SECRET=2e190dc5-941b-4b88-96c6-8704f3337e4f
MICROSOFT_TENANT_ID=9e538254-9fc8-4c58-8017-eda881f4d21f
MICROSOFT_REDIRECT_URI=http://localhost:5001/api/auth/sso/microsoft/callback

# Microsoft Entra Security Group Object IDs for RBAC
# Get these from Azure AD > Groups > Security Groups > Object ID
SUPER_ADMIN_GROUP_ID=b4ed8d6a-6689-4fac-84b9-a1fa77d3dada
ORG_ADMIN_GROUP_ID=12e4e49a-bc20-4c35-a4b9-8c114c7d361c
USER_GROUP_ID=09a79ff1-e58b-40a8-9d5a-b45d4dcb750b

# Frontend/Backend URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5001

# Email (optional)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@gatekeeper.local

# Break-glass key for super admin emergency access
BREAKGLASS_KEY=